+package ru.minisip.update;
+
+import android.content.Context;
+
+import ru.minisip.log.LogSink;
+
+import java.io.File;
+
+/**
+ * Проверка и установка APK-обновлений из GitHub Releases. Один экземпляр на приложение.
+ * Проверка и скачивание идут в фоновом потоке, колбэки — в главном.
+ */
+public interface Update {
+
+    interface Listener {
+        /** Проверка завершена. hasUpdate=true → сейчас же начнётся download(). */
+        default void onChecked(Result r) {}
+
+        /** Прогресс скачивания, 0..100. */
+        default void onProgress(int percent) {}
+
+        /** APK скачан; установка — по команде install(). */
+        default void onDownloaded(File apk) {}
+
+        /** Любая ошибка проверки или скачивания: reason — готовый текст для UI. */
+        default void onError(String reason) {}
+    }
+
+    /** Итог проверки канала. tag — только для отображения. */
+    final class Result {
+        public boolean hasUpdate;
+        public long releaseMs;
+        public String tag;
+        public String changelog;
+        /** Стабильный канал пуст (404): предложить пользователю пре-релизы. */
+        public boolean noStable;
+    }
+
+    /** "stable" или "prerelease". Сохраняется в prefs. */
+    void setChannel(String channel);
+
+    String channel();
+
+    /** GET к выбранному каналу. При hasUpdate=true сам зовёт download(). */
+    void check(Listener l);
+
+    /** Скачать APK последнего релиза в кэш с прогрессом. */
+    void download(Listener l);
+
+    /** Запустить системный установщик APK, скачанного последним download(). */
+    void install();
+
+    /** Куда писать журнал событий (null — никуда). Строки без секретов. */
+    void setLogSink(LogSink s);
+
+    static Update create(Context ctx) {
+        return new UpdateImpl(ctx);
+    }
+}
diff --git a/app/src/main/java/ru/minisip/update/UpdateImpl.java b/app/src/main/java/ru/minisip/update/UpdateImpl.java
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/ru/minisip/update/UpdateImpl.java
@@ -0,0 +1,81 @@
+package ru.minisip.update;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+import ru.minisip.log.LogSink;
+
+import java.io.File;
+
+/**
+ * Реализация проверки и установки обновлений. Проверка и скачивание — в фоновом потоке,
+ * колбэки — в главном. Шаги 3–5 README добавляют check/download/install.
+ */
+final class UpdateImpl implements Update {
+
+    private static final String TAG = "MiniSIP-Update";
+
+    private final Context ctx;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private volatile LogSink sink;
+    private volatile String channel;
+
+    UpdateImpl(Context ctx) {
+        this.ctx = ctx.getApplicationContext();
+        SharedPreferences p = this.ctx.getSharedPreferences(UpdateConfig.PREFS, Context.MODE_PRIVATE);
+        this.channel = p.getString(UpdateConfig.KEY_CHANNEL, UpdateConfig.CH_STABLE);
+    }
+
+    @Override
+    public void setLogSink(LogSink s) {
+        sink = s;
+    }
+
+    /** Одна точка журнала: logcat и панель лога. Секреты сюда не передавать. */
+    private void log(String m) {
+        Log.i(TAG, m);
+        LogSink s = sink;
+        if (s != null) s.log(m);
+    }
+
+    @Override
+    public synchronized void setChannel(String c) {
+        if (c == null) return;
+        channel = c;
+        ctx.getSharedPreferences(UpdateConfig.PREFS, Context.MODE_PRIVATE)
+                .edit().putString(UpdateConfig.KEY_CHANNEL, c).apply();
+        log("channel: " + c);
+    }
+
+    @Override
+    public synchronized String channel() {
+        return channel;
+    }
+
+    @Override
+    public void check(Listener l) {
+        log("check: stub (step 3)");
+    }
+
+    @Override
+    public void download(Listener l) {
+        log("download: stub (step 4)");
+    }
+
+    @Override
+    public void install() {
+        log("install: stub (step 5)");
+    }
+
+    /** Файл APK в кэше. Создаётся по требованию на шаге 4. */
+    @SuppressWarnings("unused")
+    File apkFile() {
+        File dir = new File(ctx.getExternalCacheDir(), "updates");
+        if (!dir.exists()) //noinspection ResultOfMethodCallIgnored
+            dir.mkdirs();
+        return new File(dir, "minisip.apk");
+    }
+}
